<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!-- Every suppression states why the rule does not apply. Keep this list short. -->
<suppressions>
  <!-- Architecture-test fixtures deliberately break project rules to prove the rules catch them. -->
  <suppress checks="MissingJavadocType|MissingJavadocMethod|JavadocPackage"
            files=".*[\\/]architecture[\\/]fixture[\\/].*"/>
  <!-- Integration tests end in IT, the Maven Failsafe convention this project uses to separate them. -->
  <suppress checks="AbbreviationAsWordInName" files=".*IT\.java"/>
</suppressions>
